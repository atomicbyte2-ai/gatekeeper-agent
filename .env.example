# Copy to .env for local testing. NEVER commit .env.
# The 32-byte HMAC secret from the Agent Games dashboard (Rotate Secret).
# Shown exactly once at registration — store it here and in Vercel env vars.
AGENT_GAMES_HMAC_SECRET=
# Outbound HMAC encoding: hex (default) or base64. Flip if preflight fails
# with a signature error.
AGENT_GAMES_HMAC_FORMAT=hex
# Optional: Kurier API key for on-chain proof finalization (not yet obtained).
KURIER_API_KEY=
